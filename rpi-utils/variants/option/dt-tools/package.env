# rpi-utils, option dt-tools (WITH_DT_TOOLS=1): the device tree and overlay tools
### dtmerge builds dtoverlay and libdtovl, which link the libfdt of lfs/dtc; dtapply, kdtc and
### overlaycheck are the scripts that drive dtoverlay and the device tree compiler
PKG_DEPS+=" lfs/dtc"
RPI_UTILS_TOOLS+=" dtapply dtmerge kdtc overlaycheck"
