#!/bin/sh
# hci-uart-recover <hci device>: the ExecStopPost= of bthelper@<hci device> (bthelper-recover.conf).
# The Raspberry Pi 3 Model B has no flow control between the SoC and the Bluetooth of its BCM43430
# (raspberrypi/firmware#1150): under load the PL011 drops bytes of a reply, the chip stops answering
# (command tx timeout) and bthelper fails with "Can't init device hci0". The first boot of an image,
# with its daemon-reload and the rest of the first boot work, lost the 255 bytes of the local name
# that way. Only powering the chip again brings it back: unbinding the serial device from
# hci_uart_bcm and binding it again does that (shutdown GPIO) and repeats the initialisation, then
# systemd starts bthelper again (Restart=on-failure, StartLimitBurst= bounds the attempts).
DEV=${1}
DRIVER=/sys/bus/serial/drivers/hci_uart_bcm

### Only after a failure: a stop at shutdown leaves the Bluetooth alone
[ "${SERVICE_RESULT}" = success ] && exit 0
SERDEV=$(basename "$(readlink -f "/sys/class/bluetooth/${DEV}/device")")
### A Bluetooth on another bus (USB) or another driver is not this one
[ -n "${DEV}" ] && [ -e "${DRIVER}/${SERDEV}" ] || exit 0

echo "${DEV} did not answer: powering ${SERDEV} again"
echo "${SERDEV}" > "${DRIVER}/unbind"
sleep 1
echo "${SERDEV}" > "${DRIVER}/bind"
